# Optional RunComfy API base URL overrides, one per product. Authentication is
# supplied by the Worker for each request; there is intentionally no shared API key.
RUNCOMFY_SERVERLESS_BASE_URL=https://api.runcomfy.net
RUNCOMFY_MODEL_API_BASE_URL=https://model-api.runcomfy.net
RUNCOMFY_TRAINER_API_BASE_URL=https://trainer-api.runcomfy.net

# Keep the Python app mounted at /mcp behind the Worker.
RUNCOMFY_MCP_MOUNT_PREFIX=
