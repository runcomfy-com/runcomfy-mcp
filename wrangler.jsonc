{
  "name": "runcomfy-mcp",
  "main": "src/index.ts",
  "compatibility_date": "2026-08-11",
  "workers_dev": false,
  "preview_urls": false,
  "routes": [
    { "pattern": "mcp.runcomfy.com", "custom_domain": true }
  ],
  "containers": [
    {
      "class_name": "RuncomfyMcpContainer",
      "image": "./Dockerfile",
      "max_instances": 1
    }
  ],
  "durable_objects": {
    "bindings": [
      {
        "class_name": "RuncomfyMcpContainer",
        "name": "RUNCOMFY_MCP_CONTAINER"
      }
    ]
  },
  "kv_namespaces": [
    {
      "binding": "OAUTH_KV",
      "id": "<YOUR_KV_NAMESPACE_ID>"
    }
  ],
  "ratelimits": [
    {
      "name": "MCP_DCR_RATE_LIMITER",
      "namespace_id": "2026081201",
      "simple": {
        "limit": 60,
        "period": 60
      }
    },
    {
      "name": "MCP_AUTHORIZE_RATE_LIMITER",
      "namespace_id": "2026081202",
      "simple": {
        "limit": 120,
        "period": 60
      }
    },
    {
      "name": "MCP_DIRECT_TOKEN_RATE_LIMITER",
      "namespace_id": "2026081203",
      "simple": {
        "limit": 600,
        "period": 60
      }
    }
  ],
  "triggers": {
    "crons": ["17 4 * * *"]
  },
  "migrations": [
    {
      "tag": "v1",
      "new_sqlite_classes": ["RuncomfyMcpContainer"]
    }
  ],
  "vars": {
    "CONTAINER_INSTANCE_NAME": "runcomfy-unified",
    "CONTAINER_STARTUP_TIMEOUT_MS": "15000",
    "CONTAINER_PORT_READY_TIMEOUT_MS": "30000",
    "CONTAINER_WAIT_INTERVAL_MS": "300",
    "MCP_MAX_BODY_BYTES": "1048576",
    "OPENAI_APPS_CHALLENGE": "tu-ebEBxdSb-Qdj5z-4rfU7lWIrgeD9hcr6vHxMgLco",
    "RUNCOMFY_SERVERLESS_BASE_URL": "https://api.runcomfy.net",
    "RUNCOMFY_MODEL_API_BASE_URL": "https://model-api.runcomfy.net",
    "RUNCOMFY_TRAINER_API_BASE_URL": "https://trainer-api.runcomfy.net"
  }
}
